<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseWPF>true</UseWPF>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- オーバーレイキーがエントリアセンブリ名由来のため、csproj 名と一致させて固定する -->
    <AssemblyName>FloatSoda.Apps.ScreenView</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <ProjectReference Include="../ControllerInput/FloatSoda.Apps.ControllerInput.csproj" />
    <ProjectReference Include="..\..\engine\src\FloatSoda.Engine\FloatSoda.Engine.csproj" />
    <ProjectReference Include="..\..\engine\src\FloatSoda\FloatSoda.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.363">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- SteamVR 自動起動の登録に使うアプリケーション マニフェスト。exe と同じ場所に配置する。 -->
    <None Include="screenview.vrmanifest" CopyToOutputDirectory="PreserveNewest" />
    <None Include="screenview_icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
