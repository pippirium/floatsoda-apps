    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- オーバーレイキーがエントリアセンブリ名由来のため、移植元(samples/FloatSoda.Samples.WristAgent)と同じ名前を固定する -->
